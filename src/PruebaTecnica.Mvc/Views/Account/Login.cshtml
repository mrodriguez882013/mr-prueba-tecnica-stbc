@model PruebaTecnica.Mvc.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_LayoutSinMenu";
}

<div class="login-container">

    <div class="login-card">

        <div class="text-center mb-4">

            <img src="~/images/Bac_Credomatic_logo.png"
                 class="login-logo"
                 alt="BAC" />

            <p class="text-muted mb-0">
                Sistema de Registro de Ventas
            </p>

        </div>

        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    Usuario
                </label>

                <input asp-for="Username"
                       class="form-control"
                       placeholder="Usuario"
                       autofocus />

                <span asp-validation-for="Username"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">
                    Contraseña
                </label>

                <input asp-for="Password"
                       type="password"
                       placeholder="Contraseña"
                       class="form-control" />

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>
            </div>

            <button type="submit"
                    class="btn btn-danger btn-lg w-100 fw-bold">
                Ingresar
            </button>

        </form>

    </div>

</div>