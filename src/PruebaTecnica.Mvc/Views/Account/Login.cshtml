@model PruebaTecnica.Mvc.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_LayoutSinMenu";
}

<div class="row justify-content-center align-items-center" style="height: 80vh;">
    <div class="col-md-4">
        <div class="card shadow border-0">
            <div class="card-body p-4">
                <h3 class="text-center text-danger fw-bold mb-4">BAC CREDOMATIC</h3>
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3 small"></div>
                    
                    <div class="mb-3">
                        <label class="form-label">Usuario</label>
                        <input asp-for="Username" class="form-control" placeholder="" autofocus />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 py-2 fw-bold">Ingresar</button>
                </form>
            </div>
        </div>
    </div>
</div>